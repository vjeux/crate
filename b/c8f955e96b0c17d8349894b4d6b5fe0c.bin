// audio-worklet.js — written by px-site. Hosts px_audio_worklet.wasm (the mixer).
class PxAudio extends AudioWorkletProcessor {
  constructor() {
    super();
    this.ex = null;
    this.started = false;
    this.port.onmessage = (e) => {
      try { this.msg(e.data); } catch (err) { this.port.postMessage({ t: 'error', msg: String(err) }); }
    };
  }
  msg(m) {
    if (m.t === 'init') {
      this.ex = new WebAssembly.Instance(new WebAssembly.Module(m.wasm), {}).exports;
      this.ex.px_init(sampleRate, currentFrame);
      return;
    }
    if (!this.ex) return;
    if (m.t === 'rec') { this.rec = new Float32Array(m.frames * 2); this.recAt = 0; return; }
    const n = m.b.byteLength;
    const p = this.ex.px_inbox(n);
    new Uint8Array(this.ex.memory.buffer, p, n).set(new Uint8Array(m.b));
    if (m.t === 'cmd') this.ex.px_commands(n);
    else if (m.t === 'clip') this.ex.px_clip(m.id, n, m.mode);
  }
  process(inputs, outputs) {
    const out = outputs[0];
    if (!this.ex || !out || out.length === 0) return true;
    if (!this.started) {
      this.started = true;
      this.ex.px_set_clock(currentFrame);
      this.port.postMessage({ t: 'clock0', frame: currentFrame });
    }
    const n = out[0].length;
    const p = this.ex.px_render(n);
    const f = new Float32Array(this.ex.memory.buffer, p, 2 * n);
    out[0].set(f.subarray(0, n));
    if (out.length > 1) out[1].set(f.subarray(n, 2 * n));
    if (this.rec) {
      // Test hook (?audiorec=SECS): keep a copy of what was output, post it when full.
      const cap = this.rec.length / 2;
      for (let i = 0; i < n && this.recAt < cap; i++, this.recAt++) {
        this.rec[2 * this.recAt] = f[i];
        this.rec[2 * this.recAt + 1] = f[n + i];
      }
      if (this.recAt >= cap) {
        const b = this.rec.buffer;
        this.rec = null;
        this.port.postMessage({ t: 'recdone', b, rate: sampleRate }, [b]);
      }
    }
    const k = this.ex.px_ended_take();
    if (k > 0) {
      const ids = new Uint32Array(this.ex.memory.buffer, this.ex.px_ended_ptr(), k).slice();
      this.ex.px_ended_clear();
      this.port.postMessage({ t: 'ended', ids: ids.buffer }, [ids.buffer]);
    }
    return true;
  }
}
registerProcessor('px-audio', PxAudio);
