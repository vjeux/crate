<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="10M Pixels">
<title>10 Million Pixels</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<style>
html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; overflow: hidden; touch-action: none; overscroll-behavior: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
#box { position: fixed; left: env(safe-area-inset-left); right: env(safe-area-inset-right); top: env(safe-area-inset-top); bottom: env(safe-area-inset-bottom); overflow: hidden; touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
canvas { display: block; position: absolute; left: 0; top: 0; outline: none; transform-origin: 0 0; touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
#crash { position: fixed; inset: 0; z-index: 50; display: none; align-items: center; justify-content: center; box-sizing: border-box; padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); background: #000; color: #eee; font: 16px -apple-system, system-ui, sans-serif; opacity: 0; transition: opacity .35s ease-out; }
#crash.on { display: flex; }
#crash.shown { opacity: 1; }
#crash .card { display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 32em; text-align: center; transform: scale(.85); transition: transform .55s cubic-bezier(.34, 1.56, .64, 1); }
#crash.shown .card { transform: scale(1); }
#crash .px { display: grid; grid-template-columns: repeat(3, 16px); gap: 4px; }
#crash .px i { width: 16px; height: 16px; background: #3b3b3b; animation: pxpop .45s cubic-bezier(.34, 1.56, .64, 1) both; }
#crash .px i:nth-child(2) { animation-delay: .06s; } #crash .px i:nth-child(3) { animation-delay: .12s; }
#crash .px i:nth-child(4) { animation-delay: .18s; } #crash .px i:nth-child(6) { animation-delay: .24s; }
#crash .px i:nth-child(7) { animation-delay: .30s; } #crash .px i:nth-child(8) { animation-delay: .36s; } #crash .px i:nth-child(9) { animation-delay: .42s; }
#crash .px i.g { background: #ffd23f; animation: pxpop .45s cubic-bezier(.34, 1.56, .64, 1) .55s both, pxglow 1.6s ease-in-out 1.1s infinite; }
@keyframes pxpop { from { transform: scale(0); } to { transform: scale(1); } }
@keyframes pxglow { 0%, 100% { box-shadow: 0 0 6px #ffb800; } 50% { box-shadow: 0 0 22px #ffb800; transform: scale(1.15); } }
#crash h1 { font-size: 22px; margin: 4px 0 0; }
#crash p { margin: 0; opacity: .82; line-height: 1.35; }
#crash button { font: 600 18px -apple-system, system-ui, sans-serif; min-width: 180px; min-height: 48px; padding: 0 28px; border: 0; border-radius: 10px; background: #fff; color: #000; cursor: pointer; }
#crash .sent { font-size: 13px; opacity: .6; }
#crash details { font-size: 12px; opacity: .55; max-width: 100%; }
#crash pre { white-space: pre-wrap; word-break: break-word; text-align: left; max-height: 30vh; overflow: auto; -webkit-user-select: text; user-select: text; }
#a2hs { position: fixed; z-index: 40; left: 50%; bottom: max(12px, env(safe-area-inset-bottom)); transform: translate(-50%, 160%); display: none; align-items: center; gap: 12px; box-sizing: border-box; width: min(560px, calc(100vw - 24px - env(safe-area-inset-left) - env(safe-area-inset-right))); padding: 10px 8px 10px 16px; background: rgba(12, 12, 12, .94); color: #eee; border: 2px solid #ffd23f; border-radius: 12px; font: 15px -apple-system, system-ui, sans-serif; line-height: 1.3; transition: transform .45s cubic-bezier(.34, 1.56, .64, 1); }
#a2hs.on { display: flex; }
#a2hs.shown { transform: translate(-50%, 0); }
#a2hs b { color: #ffd23f; }
#a2hs .share { display: inline-block; width: 15px; height: 18px; vertical-align: -3px; }
#a2hs button { flex: none; min-width: 44px; min-height: 44px; border: 0; border-radius: 8px; background: transparent; color: #eee; font: 600 22px -apple-system, system-ui, sans-serif; cursor: pointer; }
</style>
</head>
<body>
<div id="box"><canvas id="game" tabindex="0"></canvas></div>
<div id="crash" role="alert"><div class="card"><div class="px"><i></i><i></i><i></i><i></i><i class="g"></i><i></i><i></i><i></i><i></i></div><h1 id="crash-title">The game stopped</h1><p id="crash-text">Something went wrong. Your progress up to the last autosave is safe.</p><button id="crash-reload">Reload</button><p class="sent" id="crash-sent"></p><details><summary id="crash-summary">Details</summary><pre id="crash-detail"></pre></details></div></div>
<div id="a2hs" role="status"><span id="a2hs-text"></span><button id="a2hs-close" aria-label="Close">&times;</button></div>
<script>
// The crash screen (wasm panics, a game that never started or stopped responding) and its report
// to the leaderboard server (platform::crash). Here, not in Rust: after a panic the wasm module is
// dead, and a page whose wasm never loaded has none.
(() => {
  const SERVER = 'https://fooo.fr/pixels/api/'; // game::det::board::SERVER
  const q = new URLSearchParams(location.search);
  let shown = false, lastError = '', visibleSince = performance.now();
  const $ = id => document.getElementById(id);
  // At most 10 reports a day from this browser.
  function allowed() {
    const day = new Date().toISOString().slice(0, 10);
    let [d, n] = (localStorage.getItem('10mpv:crashes') || '').split(' ');
    n = d === day ? +n || 0 : 0;
    if (n >= 10) return false;
    localStorage.setItem('10mpv:crashes', day + ' ' + (n + 1));
    return true;
  }
  // body: the report (JSON text); send: the player's setting; detail: what Details shows.
  // Texts are English keys the game translates (window.__pxText, published by the game in the
  // player's language; English when the game never ran).
  const T = k => (window.__pxText && window.__pxText[k]) || k;
  // Every pointer down the page gets, wherever it lands (window.__pxPageDowns): with the game's
  // own count (window.__pxInput.downs) it tells a dead tap the page never saw from one the game
  // did not take.
  addEventListener('pointerdown', () => { window.__pxPageDowns = (window.__pxPageDowns || 0) + 1; }, { capture: true, passive: true });
  window.__pxCrash = (body, send, detail, title, text) => {
    if (shown) return;
    shown = true;
    $('crash-title').textContent = T(title || 'The game stopped');
    $('crash-text').textContent = T(text || 'Something went wrong. Your progress up to the last autosave is safe.');
    $('crash-reload').textContent = T('Reload');
    $('crash-summary').textContent = T('Details');
    $('crash-detail').textContent = detail || '';
    let sent = 'Crash reports are off (Settings).';
    // A page served from this machine is a developer's test: its reports go only where board=
    // says (a local px-board), never to the players' server.
    const local = /^(localhost|127\.|\[::1\]|0\.0\.0\.0)/.test(location.hostname);
    if (send && local && !q.get('board')) sent = '';
    else if (send) {
      sent = 'A report was sent to the developer. Thank you!';
      try {
        if (allowed()) {
          let s = q.get('board') || SERVER;
          if (!s.endsWith('/')) s += '/';
          fetch(s + 'crash', { method: 'POST', body, mode: 'no-cors', keepalive: true }).catch(() => {});
        }
      } catch (e) {}
    }
    $('crash-sent').textContent = T(sent);
    const el = $('crash');
    el.classList.add('on');
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('shown')));
  };
  $('crash-reload').onclick = () => location.reload();
  // "Add to Home Screen", once, in iOS Safari outside the installed app: a home screen app runs
  // full screen and offline, and iOS keeps its storage. Shown 3 s after the first tap (not over
  // the tap-to-start gate), gone after 14 s or on its close button. ?a2hs shows it anywhere.
  (() => {
    const ua = navigator.userAgent;
    const ios = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const safari = ios && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
    const installed = navigator.standalone === true || matchMedia('(display-mode: standalone)').matches;
    const want = q.has('a2hs') || (safari && !installed && !localStorage.getItem('10mpv:a2hs'));
    if (!want || shown) return;
    const el = $('a2hs');
    const hide = () => { el.classList.remove('shown'); setTimeout(() => el.classList.remove('on'), 500); };
    $('a2hs-close').onclick = e => { e.stopPropagation(); hide(); };
    addEventListener('pointerdown', () => setTimeout(() => {
      if (shown) return;
      try { localStorage.setItem('10mpv:a2hs', String(Date.now())); } catch (e) {}
      const esc = s => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
      const share = '<b>' + esc(T('Share')) + '</b> <svg class="share" viewBox="0 0 15 18" fill="none" stroke="rgb(255,210,63)" stroke-width="1.6"><path d="M7.5 1v11M3.5 5l4-4 4 4M4 8H1.5v9h12V8H11"/></svg>';
      // iOS 26 Safari keeps Share in its ⋯ menu (and Add to Home Screen under More in the share
      // sheet); iOS 18 and before show Share in the toolbar: the hint names both.
      const more = '<b class="more">\u22EF</b>';
      $('a2hs-text').innerHTML = esc(T('Play it like an app: tap {0} or {1}, then {2}. It works offline, full screen, and keeps your saves.')).replace('{0}', more).replace('{1}', share).replace('{2}', '<b>' + esc(T('Add to Home Screen')) + '</b>');
      el.classList.add('on');
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('shown')));
      setTimeout(hide, 14000);
    }, q.has('a2hs') ? 0 : 3000), { once: true });
  })();
  // The phone took the game's graphics away (memory pressure, a long time in the background): the
  // renderer cannot rebuild them, so offer a reload.
  const canvas = $('game');
  if (canvas) canvas.addEventListener('webglcontextlost', e => { e.preventDefault(); report('webgl', 'WebGL context lost', '', 'The graphics stopped', 'The device reset the game\'s graphics. Reload to go on; your progress up to the last autosave is safe.'); });
  function report(kind, message, where, title, text) {
    const ctx = window.__pxCtx || {};
    const body = JSON.stringify({ build: ctx.build || 'dev', level: ctx.level || 0, kind, message: String(message).slice(0, 2000), where: where ? String(where).slice(0, 300) : undefined, ua: navigator.userAgent.slice(0, 300), secs: Math.round(performance.now() / 100) / 10 });
    window.__pxCrash(body, ctx.send !== false, String(message) + (where ? '\n' + where : ''), title, text);
  }
  const NOSTART = ['The game could not start', 'Check the connection and reload. If it keeps happening, this browser may be too old.'];
  window.__pxStartFailed = e => report('error', 'start: ' + (e && e.message || e), e && e.stack ? String(e.stack).split('\n').slice(0, 3).join(' | ') : '', NOSTART[0], NOSTART[1]);
  addEventListener('error', e => {
    lastError = (e.message || 'error') + (e.filename ? ' (' + e.filename.split('/').pop() + ':' + e.lineno + ')' : '');
    if (!window.__pxFrame) report('error', e.message || 'error', e.filename ? e.filename + ':' + e.lineno + ':' + e.colno : '', NOSTART[0], NOSTART[1]);
  });
  addEventListener('unhandledrejection', e => {
    const r = e.reason;
    lastError = String(r && r.message || r);
    if (!window.__pxFrame) report('rejection', lastError, r && r.stack ? String(r.stack).split('\n').slice(0, 2).join(' | ') : '', NOSTART[0], NOSTART[1]);
  });
  document.addEventListener('visibilitychange', () => { visibleSince = performance.now(); });
  // A game that stopped drawing (an exception broke its frame loop) while the page draws: the
  // page's own animation frames keep coming but the game's do not, for 10 s and 30 frames. (A
  // timer would also fire after one long busy task, or under a test's virtual time, when no
  // frame ran at all.)
  let lastGame = 0, idleFrames = 0;
  const beat = () => {
    const f = window.__pxFrame;
    if (f !== lastGame) { lastGame = f; idleFrames = 0; }
    else if (f && !window.__pxBusy && document.visibilityState === 'visible') {
      idleFrames++;
      const now = performance.now();
      if (idleFrames >= 30 && now - f > 10000 && now - visibleSince > 10000) report('error', 'the game stopped responding (no frame for ' + Math.round((now - f) / 1000) + ' s)' + (lastError ? ': ' + lastError : ''), '');
    }
    if (!shown) requestAnimationFrame(beat);
  };
  requestAnimationFrame(beat);
})();
</script>
<script type="module">
import init from './pkg/game.js';
init().catch(e => window.__pxStartFailed(e));
</script>
</body>
</html>
